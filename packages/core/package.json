{
  "name": "@reework/core",
  "version": "1.0.0",
  "description": "Build durable, human-in-the-loop AI agents on pi-durable: plugins, gated actions, an HTTP/WS protocol and a testing kit.",
  "keywords": [
    "agent",
    "ai-agents",
    "durable",
    "human-in-the-loop",
    "llm",
    "reework"
  ],
  "homepage": "https://github.com/pelerintech/reework/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/pelerintech/reework/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelerintech/reework.git",
    "directory": "packages/core"
  },
  "bin": {
    "reework": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "reework-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "reework-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./internal": {
      "reework-source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/node-server": "1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@reework/types": "workspace:*",
    "hono": "^4.13.13",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
