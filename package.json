{
  "name": "reework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "prepare": "husky",
    "check:packages": "node scripts/check-dist.mjs && pnpm -r --filter \"./packages/*\" exec publint --strict && pnpm -r --filter \"./packages/*\" exec attw --pack . --profile esm-only",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@reework/client": "workspace:*",
    "@reework/core": "workspace:*",
    "@reework/tui": "workspace:*",
    "@reework/types": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.16.0"
}
